# --- third-party / huge build inputs (NOT source) -------------------------
# 288 MB: Go MSI + extracted GOROOT + Veea Lobster Trap source we built from
# + portable-git installer. Reproducible — see README "Building the binary".
/vendor/

# --- Python caches / test scratch ----------------------------------------
__pycache__/
*.pyc
.pytest_cache/
.last_test.xml
.po
.pytest.out

# --- generated audit logs (runtime artifacts, regenerated by the demos) ---
*.ndjson
*audit*.jsonl
audit.ndjson
demo_audit.ndjson
live_audit.ndjson
lt_audit.jsonl

# --- secrets / deploy state (never commit) -------------------------------
.env
*.key
.vercel/

# NOTE: bin/lobstertrap.exe IS committed on purpose — the real Veea Lobster
# Trap binary we built from MIT source, so judges can run the live stack
# with no Go toolchain. frontend/vendor/*.js IS committed (self-hosted
# Three.js, required by the deployed UI).
